# Copy this file to .env and adjust as needed
# cp .env.example .env

# Port for noVNC browser desktop (default: 8081 → http://localhost:8081)
NOVNC_PORT=8080

# Port for VNC client (default: 5902)
VNC_PORT=5902

# Path to your designs folder on the host (default: ./designs next to this file)
DESIGNS=./designs

# Number of MPI cores for Palace EM solver (default: all available cores)
# PALACE_NP=4
